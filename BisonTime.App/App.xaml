<Application x:Class="BisonTime.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <!-- Inweb palette and type, same values as Bison Switcher (Windows/MainWindow.xaml). -->
    <Application.Resources>
        <FontFamily x:Key="Text">pack://application:,,,/Fonts/#Geist</FontFamily>
        <FontFamily x:Key="Display">pack://application:,,,/Fonts/#Unbounded</FontFamily>

        <SolidColorBrush x:Key="BgBrush" Color="#071F17"/>
        <SolidColorBrush x:Key="SideBrush" Color="#0A271D"/>
        <SolidColorBrush x:Key="CardBrush" Color="#0E3125"/>
        <SolidColorBrush x:Key="CardHiBrush" Color="#133B2D"/>
        <SolidColorBrush x:Key="LineBrush" Color="#1F4A3B"/>
        <SolidColorBrush x:Key="EdgeBrush" Color="#2E5E4C"/>
        <SolidColorBrush x:Key="TextBrush" Color="#F7F7F7"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#94ADA3"/>
        <SolidColorBrush x:Key="FaintBrush" Color="#5E7D71"/>
        <SolidColorBrush x:Key="LimeBrush" Color="#F0FC7E"/>
        <SolidColorBrush x:Key="OrangeBrush" Color="#EF583D"/>
        <SolidColorBrush x:Key="GreenBrush" Color="#003B29"/>

        <!-- Buttons -->
        <Style x:Key="Primary" TargetType="Button">
            <Setter Property="Foreground" Value="#003B29"/>
            <Setter Property="Background" Value="#F0FC7E"/>
            <Setter Property="BorderBrush" Value="#F0FC7E"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" CornerRadius="8" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="b" Property="Opacity" Value="0.75"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="b" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Ghost" TargetType="Button" BasedOn="{StaticResource Primary}">
            <Setter Property="Foreground" Value="#F7F7F7"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#2E5E4C"/>
            <Setter Property="FontWeight" Value="Medium"/>
        </Style>
        <Style x:Key="Quiet" TargetType="Button" BasedOn="{StaticResource Primary}">
            <Setter Property="Foreground" Value="#94ADA3"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="FontWeight" Value="Normal"/>
        </Style>
        <Style x:Key="Big" TargetType="Button" BasedOn="{StaticResource Primary}">
            <Setter Property="Foreground" Value="#F0FC7E"/>
            <Setter Property="Background" Value="#003B29"/>
            <Setter Property="BorderBrush" Value="#003B29"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="16,10"/>
        </Style>

        <!-- Toggle switch: lime track + green knob when on, like BS -->
        <Style x:Key="Toggle" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Width="30" Height="17" Background="Transparent">
                            <Border x:Name="track" CornerRadius="9" Background="#16392C" BorderBrush="#2E5E4C" BorderThickness="1"/>
                            <Ellipse x:Name="knob" Width="11" Height="11" Fill="#94ADA3" HorizontalAlignment="Left" Margin="3,0,0,0"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="track" Property="Background" Value="#F0FC7E"/>
                                <Setter TargetName="track" Property="BorderBrush" Value="#F0FC7E"/>
                                <Setter TargetName="knob" Property="Fill" Value="#003B29"/>
                                <Setter TargetName="knob" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="knob" Property="Margin" Value="0,0,3,0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Text input -->
        <Style x:Key="Input" TargetType="TextBox">
            <Setter Property="Foreground" Value="#F7F7F7"/>
            <Setter Property="Background" Value="#0A271D"/>
            <Setter Property="BorderBrush" Value="#1F4A3B"/>
            <Setter Property="CaretBrush" Value="#F0FC7E"/>
            <Setter Property="SelectionBrush" Value="#F0FC7E"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="6,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="b" CornerRadius="8" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="b" Property="BorderBrush" Value="#F0FC7E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Menus (project pickers) in the dark palette -->
        <Style TargetType="ContextMenu">
            <Setter Property="Background" Value="#0E3125"/>
            <Setter Property="Foreground" Value="#F7F7F7"/>
            <Setter Property="BorderBrush" Value="#2E5E4C"/>
            <Setter Property="FontFamily" Value="{StaticResource Text}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="4">
                            <ScrollViewer MaxHeight="360" VerticalScrollBarVisibility="Auto">
                                <ItemsPresenter/>
                            </ScrollViewer>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="MenuItem">
            <Setter Property="Foreground" Value="#F7F7F7"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="b" Background="Transparent" CornerRadius="6" Padding="10,6">
                            <ContentPresenter ContentSource="Header"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#1F4A3B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="#0A271D"/>
            <Setter Property="Foreground" Value="#F7F7F7"/>
            <Setter Property="BorderBrush" Value="#2E5E4C"/>
        </Style>

        <!-- Slim scrollbar -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="8"/>
            <Setter Property="MinWidth" Value="8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border Background="#1F4A3B" CornerRadius="4" Margin="1"/>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Application.Resources>
</Application>
