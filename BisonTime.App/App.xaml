<Application x:Class="BisonTime.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <!-- Inweb palette and type, same values as Bison Switcher (Windows/MainWindow.xaml). -->
    <Application.Resources>
        <FontFamily x:Key="Text">pack://application:,,,/Fonts/#Geist</FontFamily>
        <FontFamily x:Key="Display">pack://application:,,,/Fonts/#Unbounded</FontFamily>

        <!-- Variant A: Material 3 dark on Inweb green. Tonal surfaces, lime as the primary container. -->
        <SolidColorBrush x:Key="BgBrush" Color="#0B2219"/>
        <SolidColorBrush x:Key="SideBrush" Color="#0B2219"/>
        <SolidColorBrush x:Key="HeadBrush" Color="#12352A"/>
        <SolidColorBrush x:Key="CardBrush" Color="#13342A"/>
        <SolidColorBrush x:Key="CardHiBrush" Color="#183D31"/>
        <SolidColorBrush x:Key="TonalBrush" Color="#2C4A3E"/>
        <SolidColorBrush x:Key="LineBrush" Color="#1D3D31"/>
        <SolidColorBrush x:Key="EdgeBrush" Color="#638878"/>
        <SolidColorBrush x:Key="TextBrush" Color="#E8F0EC"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#9DB5AB"/>
        <SolidColorBrush x:Key="FaintBrush" Color="#8BA79B"/>
        <SolidColorBrush x:Key="LimeBrush" Color="#F0FC7E"/>
        <SolidColorBrush x:Key="OrangeBrush" Color="#EF583D"/>
        <SolidColorBrush x:Key="GreenBrush" Color="#003B29"/>

        <!-- Keyboard focus: a 2px lime ring outside the control (never removed). -->
        <Style x:Key="FocusRing">
            <Setter Property="Control.Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Rectangle Margin="-3" RadiusX="20" RadiusY="20" Stroke="#F0FC7E" StrokeThickness="2" SnapsToDevicePixels="True"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="FocusRingSquare">
            <Setter Property="Control.Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Rectangle Margin="-2" RadiusX="8" RadiusY="8" Stroke="#F0FC7E" StrokeThickness="2" SnapsToDevicePixels="True"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Buttons: M3 pills. Primary = filled lime, Tonal = filled green, Ghost = outlined, Quiet = text. -->
        <Style x:Key="Primary" TargetType="Button">
            <Setter Property="Foreground" Value="#003B29"/>
            <Setter Property="Background" Value="#F0FC7E"/>
            <Setter Property="BorderBrush" Value="#F0FC7E"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="b" CornerRadius="18" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"/>
                            <Border x:Name="state" CornerRadius="18" Background="{TemplateBinding Foreground}" Opacity="0"/>
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="state" Property="Opacity" Value="0.08"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="state" Property="Opacity" Value="0.14"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.38"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Tonal" TargetType="Button" BasedOn="{StaticResource Primary}">
            <Setter Property="Foreground" Value="#E8F0EC"/>
            <Setter Property="Background" Value="#2C4A3E"/>
            <Setter Property="BorderBrush" Value="#2C4A3E"/>
        </Style>
        <Style x:Key="Ghost" TargetType="Button" BasedOn="{StaticResource Primary}">
            <Setter Property="Foreground" Value="#E8F0EC"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#638878"/>
            <Setter Property="FontWeight" Value="Medium"/>
        </Style>
        <Style x:Key="Quiet" TargetType="Button" BasedOn="{StaticResource Primary}">
            <Setter Property="Foreground" Value="#9DB5AB"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="MinHeight" Value="32"/>
        </Style>
        <Style x:Key="Icon" TargetType="Button" BasedOn="{StaticResource Quiet}">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="MinHeight" Value="0"/>
        </Style>
        <Style x:Key="Big" TargetType="Button" BasedOn="{StaticResource Primary}">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="20,10"/>
        </Style>

        <!-- Toggle switch: lime track + green knob when on, like BS -->
        <Style x:Key="Toggle" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Width="44" Height="24" Background="Transparent">
                            <Border x:Name="track" CornerRadius="12" Background="#13342A" BorderBrush="#8BA79B" BorderThickness="2"/>
                            <Ellipse x:Name="knob" Width="12" Height="12" Fill="#8BA79B" HorizontalAlignment="Left" Margin="6,0,0,0"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="track" Property="Background" Value="#F0FC7E"/>
                                <Setter TargetName="track" Property="BorderBrush" Value="#F0FC7E"/>
                                <Setter TargetName="knob" Property="Fill" Value="#003B29"/>
                                <Setter TargetName="knob" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="knob" Property="Width" Value="16"/>
                                <Setter TargetName="knob" Property="Height" Value="16"/>
                                <Setter TargetName="knob" Property="Margin" Value="0,0,4,0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Text input -->
        <Style x:Key="Input" TargetType="TextBox">
            <Setter Property="Foreground" Value="#E8F0EC"/>
            <Setter Property="Background" Value="#0E281F"/>
            <Setter Property="BorderBrush" Value="#638878"/>
            <Setter Property="CaretBrush" Value="#F0FC7E"/>
            <Setter Property="SelectionBrush" Value="#F0FC7E"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="b" CornerRadius="12" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="b" Property="BorderBrush" Value="#F0FC7E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Menus (project pickers) in the dark palette -->
        <Style TargetType="ContextMenu">
            <Setter Property="Background" Value="#183D31"/>
            <Setter Property="Foreground" Value="#E8F0EC"/>
            <Setter Property="BorderBrush" Value="#638878"/>
            <Setter Property="FontFamily" Value="{StaticResource Text}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="12" Padding="6">
                            <ScrollViewer MaxHeight="360" VerticalScrollBarVisibility="Auto">
                                <ItemsPresenter/>
                            </ScrollViewer>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="MenuItem">
            <Setter Property="Foreground" Value="#E8F0EC"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="b" Background="Transparent" CornerRadius="8" Padding="12,8">
                            <ContentPresenter ContentSource="Header"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#2C4A3E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="#0E281F"/>
            <Setter Property="Foreground" Value="#E8F0EC"/>
            <Setter Property="BorderBrush" Value="#638878"/>
        </Style>

        <!-- Slim scrollbar -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="8"/>
            <Setter Property="MinWidth" Value="8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border Background="#2C4A3E" CornerRadius="4" Margin="1"/>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Application.Resources>
</Application>
