<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>12</LangVersion>
    <UseWPF>true</UseWPF>
    <!-- WinForms only for the tray NotifyIcon. -->
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\bt.ico</ApplicationIcon>
    <AssemblyName>BisonTimeChecker</AssemblyName>
    <RootNamespace>BisonTime.App</RootNamespace>
    <Product>Bison Time Checker</Product>
    <Description>Bison Time Checker (BT) — облік часу по проєктах для щоденного звіту Inweb</Description>
    <Version>1.11.1</Version>
    <!-- Full version info: an exe without publisher metadata looks suspicious to antivirus heuristics. -->
    <Company>iEuegene</Company>
    <Authors>iEuegene</Authors>
    <Copyright>© 2026 iEuegene</Copyright>
    <AssemblyTitle>Bison Time Checker</AssemblyTitle>
    <NeutralLanguage>uk-UA</NeutralLanguage>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!-- BT's own UI is Ukrainian; .NET's translated error messages for 13 other languages are 221 files nobody reads. -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\BisonTime.Core\BisonTime.Core.csproj" />
  </ItemGroup>

  <!-- WinForms/Drawing names (Button, Brush, Point…) collide with WPF: keep them out of
       the implicit usings and write them fully qualified where needed. -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <!-- Brand fonts (OFL): Geist for text, Unbounded for headlines and numbers. -->
  <ItemGroup>
    <Resource Include="Fonts\*.ttf" />
    <Resource Include="Assets\*.png" />
    <EmbeddedResource Include="Assets\bt.ico" LogicalName="bt.ico" />
    <EmbeddedResource Include="Assets\bt-paused.ico" LogicalName="bt-paused.ico" />
    <EmbeddedResource Include="Assets\bt-done.ico" LogicalName="bt-done.ico" />
  </ItemGroup>

</Project>
