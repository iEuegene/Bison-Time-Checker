{
  "manifest_version": 3,
  "name": "Bison Time Checker",
  "short_name": "BT",
  "version": "0.2.0",
  "description": "Облік часу по проєктах для щоденного звіту Inweb. Дані не залишають ваш комп'ютер.",
  "minimum_chrome_version": "116",
  "permissions": ["tabs", "idle", "alarms", "storage"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Bison Time Checker",
    "default_icon": { "16": "icons/bt-16.png", "32": "icons/bt-32.png", "48": "icons/bt-48.png", "128": "icons/bt-128.png" }
  },
  "options_page": "options/options.html",
  "commands": {
    "toggle-pause": {
      "suggested_key": { "default": "Alt+Shift+P" },
      "description": "Пауза / продовжити облік"
    }
  },
  "icons": { "16": "icons/bt-16.png", "32": "icons/bt-32.png", "48": "icons/bt-48.png", "128": "icons/bt-128.png" },
  "content_security_policy": {
    "extension_pages": "default-src 'self'; script-src 'self'; style-src 'self'; font-src 'self'; img-src 'self' data:; connect-src 'none'; object-src 'none'"
  }
}
